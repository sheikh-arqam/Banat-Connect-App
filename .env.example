# Banat Connect — environment variables
#
# Copy to .env for local dev, or set in Vercel:
#   Project banat-app -> Settings -> Environment Variables -> Redeploy.
# Without these two values the app runs in TEMPORARY LOCAL MODE
# (data saves only in the browser, no sync) and says so on screen.
# Never put the Supabase service_role key here — the anon key is enough.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
